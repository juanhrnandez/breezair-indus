# ─── Entrega de leads ──────────────────────────────────────────────────────────
# Sin RESEND_API_KEY el formulario responde OK y el lead sólo queda en los logs
# del servidor. En producción esta variable es obligatoria.
RESEND_API_KEY=

# Destinatarios internos de cada lead (separados por coma).
# Por defecto: adm@cg.international,jorge@cg.international
LEAD_RECIPIENTS=

# ─── Medición de conversiones ──────────────────────────────────────────────────
# Sin estas variables el sitio funciona igual, pero no se puede medir
# cuántos leads genera cada canal ni optimizar la inversión publicitaria.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
